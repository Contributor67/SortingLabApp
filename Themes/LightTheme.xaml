<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовые цвета Светлой (Белой) темы -->
    <Color x:Key="WindowBgColor">#F8FAFC</Color>      <!-- Чистый нейтральный фон Slate-50 -->
    <Color x:Key="CardBgColor">#FFFFFF</Color>        <!-- Чистый белый цвет для карточек и панелей -->
    <Color x:Key="CardHoverBgColor">#F1F5F9</Color>   <!-- Slate-100 при наведении -->
    <Color x:Key="BorderColor">#CBD5E1</Color>        <!-- Slate-300 для контрастных четких границ -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>   <!-- Slate-900: глубокий тёмный текст -->
    <Color x:Key="TextSecondaryColor">#475569</Color> <!-- Slate-600 для вторичного текста -->
    <Color x:Key="TextMutedColor">#94A3B8</Color>     <!-- Slate-400 -->
    
    <!-- Акценты и индикаторы -->
    <Color x:Key="AccentColor">#2563EB</Color>        <!-- Насыщенный синий -->
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentPressedColor">#1E40AF</Color>
    
    <!-- Цвета для визуализации сортировок (сочные и четкие на белом фоне) -->
    <Color x:Key="BarDefaultColor">#0284C7</Color>      <!-- Голубой/синий: обычный элемент -->
    <Color x:Key="BarComparingColor">#D97706</Color>    <!-- Янтарный: сравнение -->
    <Color x:Key="BarSwappingColor">#DC2626</Color>     <!-- Красный: перестановка/перемещение -->
    <Color x:Key="BarPivotColor">#9333EA</Color>        <!-- Фиолетовый: опорный / шаг -->
    <Color x:Key="BarSortedColor">#059669</Color>       <!-- Изумрудный: на месте -->

    <!-- Кисти (SolidColorBrush) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBgColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    
    <SolidColorBrush x:Key="BarDefaultBrush" Color="{StaticResource BarDefaultColor}" />
    <SolidColorBrush x:Key="BarComparingBrush" Color="{StaticResource BarComparingColor}" />
    <SolidColorBrush x:Key="BarSwappingBrush" Color="{StaticResource BarSwappingColor}" />
    <SolidColorBrush x:Key="BarPivotBrush" Color="{StaticResource BarPivotColor}" />
    <SolidColorBrush x:Key="BarSortedBrush" Color="{StaticResource BarSortedColor}" />
    
    <SolidColorBrush x:Key="LogBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BadgeBgBrush" Color="#F1F5F9" />
</ResourceDictionary>
