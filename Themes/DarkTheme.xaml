<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовые цвета Тёмной темы -->
    <Color x:Key="WindowBgColor">#0F172A</Color>
    <Color x:Key="CardBgColor">#1E293B</Color>
    <Color x:Key="CardHoverBgColor">#334155</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    
    <!-- Акценты и индикаторы -->
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentPressedColor">#2563EB</Color>
    
    <!-- Цвета для визуализации сортировок -->
    <Color x:Key="BarDefaultColor">#38BDF8</Color>      <!-- Голубой: обычный элемент -->
    <Color x:Key="BarComparingColor">#FBBF24</Color>    <!-- Желтый: сравнение -->
    <Color x:Key="BarSwappingColor">#F87171</Color>     <!-- Красный: перестановка/запись -->
    <Color x:Key="BarPivotColor">#C084FC</Color>        <!-- Фиолетовый: опорный / шаг -->
    <Color x:Key="BarSortedColor">#34D399</Color>       <!-- Зеленый: на месте -->

    <!-- Кисти (SolidColorBrush) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBgColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    
    <SolidColorBrush x:Key="BarDefaultBrush" Color="{StaticResource BarDefaultColor}" />
    <SolidColorBrush x:Key="BarComparingBrush" Color="{StaticResource BarComparingColor}" />
    <SolidColorBrush x:Key="BarSwappingBrush" Color="{StaticResource BarSwappingColor}" />
    <SolidColorBrush x:Key="BarPivotBrush" Color="{StaticResource BarPivotColor}" />
    <SolidColorBrush x:Key="BarSortedBrush" Color="{StaticResource BarSortedColor}" />
    
    <SolidColorBrush x:Key="LogBgBrush" Color="#090D16" />
    <SolidColorBrush x:Key="BadgeBgBrush" Color="#1E293B" />
</ResourceDictionary>
