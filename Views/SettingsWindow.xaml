<Window x:Class="SortingLabApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки приложения" 
        Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ Настройки" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Параметры внешнего вида и горячие клавиши" 
                       FontSize="13" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Содержимое настроек -->
        <StackPanel Grid.Row="1">
            <!-- Блок темы оформления -->
            <Border Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Тема оформления интерфейса" 
                               FontWeight="SemiBold" FontSize="14" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <RadioButton x:Name="RbDarkTheme" Content="Тёмная тема (Dark)" 
                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 Margin="0,0,0,8" Checked="ThemeRadioButton_Checked"/>
                    <RadioButton x:Name="RbLightTheme" Content="Светлая тема (Light)" 
                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 Checked="ThemeRadioButton_Checked"/>
                </StackPanel>
            </Border>

            <!-- Справка по горячим клавишам -->
            <Border Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Горячие клавиши управления визуализацией:" 
                               FontWeight="SemiBold" FontSize="13" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="• Пробел — Запуск / Пауза анимации" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                    <TextBlock Text="• Стрелка вправо (→) — Шаг вперед" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                    <TextBlock Text="• Стрелка влево (←) — Шаг назад (откат состояния)" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                    <TextBlock Text="• R — Сбросить анимацию к начальному состоянию" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" Content="Закрыть" 
                Style="{StaticResource AccentButton}"
                HorizontalAlignment="Right" Width="100" Height="36"
                Click="CloseButton_Click" Margin="0,16,0,0"/>
    </Grid>
</Window>
