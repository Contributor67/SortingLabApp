<Window x:Class="SortingLabApp.Views.BenchmarkTextsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение текстов: исходный и отсортированный"
        Height="640" Width="1000"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и переключатель алгоритма для правого окна -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TbHeaderTitle" Text="Эксперимент: 100 слов"
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TbMatchStatus" Text="Результаты QuickSort и MSD RadixSort идентичны"
                               FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource BarSortedBrush}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Конечный результат алгоритма:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbQuickSort" Content="QuickSort" IsChecked="True"
                                 GroupName="AlgoGroup" Checked="AlgorithmRadio_Checked"
                                 VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="RbRadixSort" Content="MSD RadixSort"
                                 GroupName="AlgoGroup" Checked="AlgorithmRadio_Checked"
                                 VerticalAlignment="Center" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Два текста: слева начальный, справа конечный -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Начальный текст -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Начальный текст (до сортировки)" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TbSourceStats" Text="" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>

                    <TextBox x:Name="TxtInitialText" Grid.Row="1"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource LogBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Padding="8"/>
                </Grid>
            </Border>

            <!-- Конечный текст -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TbSortedTitle" Text="Конечный текст (QuickSort)" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TbSortedTime" Text="" HorizontalAlignment="Right"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>

                    <TextBox x:Name="TxtSortedText" Grid.Row="1"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Background="{DynamicResource LogBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Padding="8"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Закрыть" Click="BtnClose_Click" Padding="18,6"/>
        </StackPanel>
    </Grid>
</Window>
